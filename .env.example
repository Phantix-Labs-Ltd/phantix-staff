# Server-only (vite proxy). Browser config: src/lib/config.ts
# Sandbox cohort is managed via the shared backend /admin/sandbox/* (staff JWT).

# Backend the dev server proxies /api to. Set per environment.
API_PROXY_TARGET=http://127.0.0.1:8000
DEV_PORT=5176

# Superadmin terminal WebSocket origin (browser). Vercel rewrites cannot tunnel
# WebSockets, so the terminal connects straight to the backend origin in prod.
# Leave unset for local dev (Vite proxy forwards /api with ws:true).
# WS-capable backend origin for the superadmin terminal; empty = same origin
VITE_TERMINAL_WS_ORIGIN=